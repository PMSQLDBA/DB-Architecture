/* ============================================================================
   MODULE 03 — PARTITION FUNCTIONS
   ============================================================================
   Syntax:
     CREATE PARTITION FUNCTION function_name (data_type)
     AS RANGE LEFT | RIGHT
     FOR VALUES (boundary_list);

   LEFT  → boundary value belongs to the LEFT (lower) partition
   RIGHT → boundary value belongs to the RIGHT (upper) partition
   ============================================================================ */

USE PartitionLab;
GO

-- ── 3.1  RANGE RIGHT — most common for dates ──────────────────────────────────
-- Boundary: Jan 1 of each year
-- Partition 1 : < '2019-01-01'
-- Partition 2 : >= '2019-01-01' AND < '2020-01-01'
-- Partition 3 : >= '2020-01-01' AND < '2021-01-01'  ... and so on

CREATE PARTITION FUNCTION PF_SalesOrder_Year (DATE)
AS RANGE RIGHT
FOR VALUES (
    '2019-01-01',
    '2020-01-01',
    '2021-01-01',
    '2022-01-01',
    '2023-01-01',
    '2024-01-01'
);
GO

-- ── 3.2  RANGE LEFT — boundary value goes to lower partition ──────────────────
-- Partition 1 : <= '2019-12-31'
-- Partition 2 : > '2019-12-31' AND <= '2020-12-31' ...

CREATE PARTITION FUNCTION PF_SalesOrder_Year_LEFT (DATE)
AS RANGE LEFT
FOR VALUES (
    '2019-12-31',
    '2020-12-31',
    '2021-12-31',
    '2022-12-31',
    '2023-12-31'
);
GO

-- ── 3.3  Monthly partitioning (high-frequency OLTP) ──────────────────────────
CREATE PARTITION FUNCTION PF_Monthly (DATE)
AS RANGE RIGHT
FOR VALUES (
    '2024-01-01','2024-02-01','2024-03-01','2024-04-01',
    '2024-05-01','2024-06-01','2024-07-01','2024-08-01',
    '2024-09-01','2024-10-01','2024-11-01','2024-12-01',
    '2025-01-01'
);
GO

-- ── 3.4  Integer-based partition (Customer ID range) ─────────────────────────
CREATE PARTITION FUNCTION PF_CustomerID (INT)
AS RANGE RIGHT
FOR VALUES (10000, 20000, 30000, 40000, 50000);
-- Partition 1: < 10000  | P2: 10000-19999 | P3: 20000-29999 ... | P6: >= 50000
GO

-- ── 3.5  BIGINT partition for high-volume event IDs ──────────────────────────
CREATE PARTITION FUNCTION PF_EventID (BIGINT)
AS RANGE RIGHT
FOR VALUES (1000000, 2000000, 3000000, 4000000, 5000000);
GO

-- ── 3.6  DATETIME2 precision partition ───────────────────────────────────────
CREATE PARTITION FUNCTION PF_Transactions_DateTime (DATETIME2(0))
AS RANGE RIGHT
FOR VALUES (
    '2024-01-01 00:00:00',
    '2024-04-01 00:00:00',
    '2024-07-01 00:00:00',
    '2024-10-01 00:00:00',
    '2025-01-01 00:00:00'
);
GO

-- ── 3.7  Verify partition function boundaries ─────────────────────────────────
SELECT
    pf.name                         AS PartitionFunction,
    pf.type_desc                    AS BoundaryType,
    pf.fanout                       AS NumberOfPartitions,
    prv.boundary_id                 AS BoundaryID,
    CAST(prv.value AS VARCHAR(50))  AS BoundaryValue
FROM sys.partition_functions  pf
JOIN sys.partition_range_values prv
    ON pf.function_id = prv.function_id
ORDER BY pf.name, prv.boundary_id;
GO

-- ── 3.8  Test which partition a value maps to ─────────────────────────────────
SELECT $PARTITION.PF_SalesOrder_Year('2021-06-15') AS PartitionNumber;
-- Returns 3 (the 2021 partition)

SELECT $PARTITION.PF_SalesOrder_Year('2018-12-31') AS PartitionNumber;
-- Returns 1 (before all boundaries — the "catch-all" left partition)

SELECT $PARTITION.PF_CustomerID(25500) AS PartitionNumber;
-- Returns 3


/* ============================================================================
   MODULE 04 — PARTITION SCHEMES
   ============================================================================
   A Partition Scheme maps each partition to a filegroup.
   Number of filegroups = Number of partitions = Number of boundaries + 1
   You can also map ALL partitions to [PRIMARY] or a single FG (simpler lab).
   ============================================================================ */

-- ── 4.1  Named filegroup per partition (production best practice) ─────────────
CREATE PARTITION SCHEME PS_SalesOrder_Year
AS PARTITION PF_SalesOrder_Year
TO (
    [PRIMARY],    -- Partition 1: rows before 2019
    FG_2019,      -- Partition 2: 2019 rows
    FG_2020,      -- Partition 3: 2020 rows
    FG_2021,      -- Partition 4: 2021 rows
    FG_2022,      -- Partition 5: 2022 rows
    FG_2023,      -- Partition 6: 2023 rows
    FG_2024,      -- Partition 7: 2024 rows
    FG_FUTURE     -- Partition 8: >= 2025
);
GO

-- ── 4.2  NEXT USED — designate filegroup for the next split ──────────────────
-- Required BEFORE you split a partition (Module 09)
ALTER PARTITION SCHEME PS_SalesOrder_Year
NEXT USED FG_FUTURE;
GO

-- ── 4.3  All-to-PRIMARY scheme (simple lab / dev environment) ─────────────────
CREATE PARTITION SCHEME PS_SalesOrder_Year_Simple
AS PARTITION PF_SalesOrder_Year
ALL TO ([PRIMARY]);
GO

-- ── 4.4  Monthly scheme ───────────────────────────────────────────────────────
CREATE PARTITION SCHEME PS_Monthly
AS PARTITION PF_Monthly
ALL TO ([PRIMARY]);
GO

-- ── 4.5  Customer ID scheme ───────────────────────────────────────────────────
CREATE PARTITION SCHEME PS_CustomerID
AS PARTITION PF_CustomerID
ALL TO ([PRIMARY]);
GO

-- ── 4.6  Verify partition schemes ─────────────────────────────────────────────
SELECT
    ps.name             AS PartitionScheme,
    pf.name             AS PartitionFunction,
    dds.destination_id  AS PartitionNumber,
    fg.name             AS Filegroup
FROM sys.partition_schemes    ps
JOIN sys.partition_functions  pf  ON ps.function_id = pf.function_id
JOIN sys.destination_data_spaces dds ON ps.data_space_id = dds.partition_scheme_id
JOIN sys.filegroups           fg  ON dds.data_space_id = fg.data_space_id
ORDER BY ps.name, dds.destination_id;
GO


/* ============================================================================
   MODULE 05 — CREATING PARTITIONED TABLES FROM SCRATCH
   ============================================================================ */

USE PartitionLab;
GO

-- ── 5.1  Simple partitioned fact table ───────────────────────────────────────
CREATE TABLE dbo.FactSalesOrder
(
    SalesOrderID    INT          NOT NULL,
    OrderDate       DATE         NOT NULL,   -- ← PARTITION COLUMN
    CustomerID      INT          NOT NULL,
    SalesPersonID   INT          NULL,
    TotalDue        MONEY        NOT NULL DEFAULT 0,
    Status          TINYINT      NOT NULL DEFAULT 1,
    CreatedAt       DATETIME2(0) NOT NULL DEFAULT SYSUTCDATETIME(),
    CONSTRAINT PK_FactSalesOrder
        PRIMARY KEY CLUSTERED (SalesOrderID, OrderDate)  -- PK must include partition col
        ON PS_SalesOrder_Year (OrderDate)                -- route to partition scheme
)
ON PS_SalesOrder_Year (OrderDate);
GO

-- ── 5.2  Partitioned table with IDENTITY and heap-then-index approach ─────────
CREATE TABLE dbo.FactTransaction
(
    TransactionID   BIGINT       IDENTITY(1,1) NOT NULL,
    TxnDate         DATE         NOT NULL,
    AccountID       INT          NOT NULL,
    Amount          DECIMAL(18,4) NOT NULL,
    TxnType         CHAR(1)      NOT NULL CHECK (TxnType IN ('D','C')),
    Narration       NVARCHAR(256) NULL
)
ON PS_SalesOrder_Year (TxnDate);
GO

-- Non-unique clustered index on partition col (common pattern when IDENTITY is PK)
CREATE CLUSTERED INDEX CIX_FactTransaction_TxnDate
    ON dbo.FactTransaction (TxnDate)
    ON PS_SalesOrder_Year (TxnDate);
GO

-- ── 5.3  Partitioned by integer (Customer segments) ──────────────────────────
CREATE TABLE dbo.DimCustomerActivity
(
    ActivityID      INT          IDENTITY(1,1) NOT NULL,
    CustomerID      INT          NOT NULL,   -- ← PARTITION COLUMN
    ActivityDate    DATE         NOT NULL,
    ActivityType    VARCHAR(50)  NOT NULL,
    Score           SMALLINT     NULL
)
ON PS_CustomerID (CustomerID);
GO

-- ── 5.4  Load sample data into FactSalesOrder ─────────────────────────────────
-- Generate ~100,000 rows spread across 2019–2024
;WITH Numbers AS (
    SELECT TOP (100000) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n
    FROM sys.all_columns a CROSS JOIN sys.all_columns b
)
INSERT INTO dbo.FactSalesOrder (SalesOrderID, OrderDate, CustomerID, SalesPersonID, TotalDue, Status)
SELECT
    n                                                         AS SalesOrderID,
    DATEADD(DAY, ABS(CHECKSUM(NEWID())) % 2191, '2019-01-01') AS OrderDate,  -- 6 yrs
    ABS(CHECKSUM(NEWID())) % 50000 + 1                        AS CustomerID,
    ABS(CHECKSUM(NEWID())) % 20  + 1                          AS SalesPersonID,
    CAST(ABS(CHECKSUM(NEWID())) % 50000 / 100.0 AS MONEY)     AS TotalDue,
    1
FROM Numbers;
GO

-- ── 5.5  Verify row distribution across partitions ────────────────────────────
SELECT
    p.partition_number,
    p.rows,
    CAST(prv.value AS VARCHAR(20)) AS BoundaryValue,
    fg.name                         AS Filegroup
FROM sys.partitions          p
JOIN sys.indexes             i   ON p.object_id = i.object_id AND p.index_id = i.index_id
JOIN sys.partition_schemes   ps  ON i.data_space_id = ps.data_space_id
JOIN sys.partition_functions pf  ON ps.function_id = pf.function_id
LEFT JOIN sys.partition_range_values prv
    ON pf.function_id = prv.function_id
    AND p.partition_number = prv.boundary_id + 1   -- RIGHT boundary offset
JOIN sys.destination_data_spaces dds ON ps.data_space_id = dds.partition_scheme_id
    AND dds.destination_id = p.partition_number
JOIN sys.filegroups          fg  ON dds.data_space_id = fg.data_space_id
WHERE p.object_id = OBJECT_ID('dbo.FactSalesOrder')
  AND i.index_id  <= 1   -- clustered only
ORDER BY p.partition_number;
GO


/* ============================================================================
   MODULE 06 — PARTITIONING AN EXISTING TABLE (AdventureWorks2019)
   ============================================================================
   Real-World Scenario: The Sales.SalesOrderHeader table in AdventureWorks
   grows by millions of rows per year. Partition it by OrderDate.
   ============================================================================ */

USE AdventureWorks2019;
GO

-- ── 6.1  Examine the existing table ──────────────────────────────────────────
SELECT
    MIN(OrderDate) AS MinDate,
    MAX(OrderDate) AS MaxDate,
    COUNT(*)       AS TotalRows
FROM Sales.SalesOrderHeader;

-- ── 6.2  Create Partition Function & Scheme in AdventureWorks ─────────────────
CREATE PARTITION FUNCTION PF_AW_OrderYear (DATETIME)
AS RANGE RIGHT
FOR VALUES (
    '2011-01-01',
    '2012-01-01',
    '2013-01-01',
    '2014-01-01'
);
GO

CREATE PARTITION SCHEME PS_AW_OrderYear
AS PARTITION PF_AW_OrderYear
TO (
    [PRIMARY],
    FG_AW_2011,
    FG_AW_2012,
    FG_AW_2013,
    FG_AW_2014,
    [PRIMARY]    -- 2014+ overflow
);
GO

-- ── 6.3  Strategy: DROP existing PK, recreate on partition scheme ──────────────
--  IMPORTANT: To partition an existing table with a clustered PK, you must:
--  1. Drop the clustered PK (this becomes a heap)
--  2. Recreate the PK / clustered index ON the partition scheme
--  WARNING: On large tables, do this in a maintenance window!

-- Step A: Script the existing PK (for rollback)
-- PK is: SalesOrderID
-- We need to include OrderDate in the key to align with partition scheme

-- Step B: Check for foreign keys referencing this table
SELECT
    fk.name          AS FK_Name,
    OBJECT_NAME(fk.parent_object_id) AS ChildTable
FROM sys.foreign_keys fk
WHERE fk.referenced_object_id = OBJECT_ID('Sales.SalesOrderHeader');

-- Step C: Disable FK constraints temporarily
ALTER TABLE Sales.SalesOrderDetail NOCHECK CONSTRAINT FK_SalesOrderDetail_SalesOrderHeader_SalesOrderID;
GO

-- Step D: Drop the existing clustered PK
ALTER TABLE Sales.SalesOrderHeader
DROP CONSTRAINT PK_SalesOrderHeader_SalesOrderID;
GO

-- Step E: Recreate as partitioned clustered PK (include OrderDate)
ALTER TABLE Sales.SalesOrderHeader
ADD CONSTRAINT PK_SalesOrderHeader_SalesOrderID
PRIMARY KEY CLUSTERED (SalesOrderID, OrderDate)
ON PS_AW_OrderYear (OrderDate);
GO

-- Step F: Re-enable FK
ALTER TABLE Sales.SalesOrderDetail
CHECK CONSTRAINT FK_SalesOrderDetail_SalesOrderHeader_SalesOrderID;
GO

-- Step G: Verify partitions
SELECT
    p.partition_number,
    p.rows,
    CAST(prv.value AS VARCHAR(30)) AS BoundaryValue
FROM sys.partitions p
JOIN sys.indexes    i  ON p.object_id = i.object_id AND p.index_id = i.index_id
JOIN sys.partition_schemes  ps ON i.data_space_id = ps.data_space_id
JOIN sys.partition_functions pf ON ps.function_id = pf.function_id
LEFT JOIN sys.partition_range_values prv
    ON pf.function_id = prv.function_id
    AND p.partition_number = prv.boundary_id + 1
WHERE p.object_id = OBJECT_ID('Sales.SalesOrderHeader')
  AND i.index_id <= 1
ORDER BY p.partition_number;
GO

-- ── 6.4  Alternative: Partition WITHOUT changing the PK ───────────────────────
-- Create a NEW partitioned table, copy data, rename (online approach)
-- Safer for production systems!

CREATE TABLE Sales.SalesOrderHeader_New
(
    SalesOrderID            INT              NOT NULL,
    RevisionNumber          TINYINT          NOT NULL,
    OrderDate               DATETIME         NOT NULL,
    DueDate                 DATETIME         NOT NULL,
    ShipDate                DATETIME         NULL,
    Status                  TINYINT          NOT NULL,
    OnlineOrderFlag         dbo.Flag         NOT NULL,
    SalesOrderNumber        NVARCHAR(25)     NOT NULL,
    PurchaseOrderNumber     dbo.OrderNumber  NULL,
    AccountNumber           dbo.AccountNumber NULL,
    CustomerID              INT              NOT NULL,
    SalesPersonID           INT              NULL,
    TerritoryID             INT              NULL,
    BillToAddressID         INT              NOT NULL,
    ShipToAddressID         INT              NOT NULL,
    ShipMethodID            INT              NOT NULL,
    CreditCardID            INT              NULL,
    CreditCardApprovalCode  VARCHAR(15)      NULL,
    CurrencyRateID          INT              NULL,
    SubTotal                MONEY            NOT NULL,
    TaxAmt                  MONEY            NOT NULL,
    Freight                 MONEY            NOT NULL,
    TotalDue                MONEY            NOT NULL,
    Comment                 NVARCHAR(128)    NULL,
    rowguid                 UNIQUEIDENTIFIER NOT NULL,
    ModifiedDate            DATETIME         NOT NULL,
    CONSTRAINT PK_SalesOrderHeader_New
        PRIMARY KEY CLUSTERED (SalesOrderID, OrderDate)
        ON PS_AW_OrderYear (OrderDate)
)
ON PS_AW_OrderYear (OrderDate);
GO

-- Copy data
INSERT INTO Sales.SalesOrderHeader_New
SELECT * FROM Sales.SalesOrderHeader;
GO

-- Rename tables (atomic swap)
EXEC sp_rename 'Sales.SalesOrderHeader',     'SalesOrderHeader_Old';
EXEC sp_rename 'Sales.SalesOrderHeader_New', 'SalesOrderHeader';
GO
-- After validation: DROP TABLE Sales.SalesOrderHeader_Old


/* ============================================================================
   MODULE 07 — PARTITIONED INDEXES
   ============================================================================ */

USE PartitionLab;
GO

-- ── 7.1  Aligned non-clustered index (same partition scheme as table) ─────────
-- "Aligned" means the index uses the SAME partition function.
-- Benefits: fast partition switch, per-partition rebuild, eliminate partitions.

CREATE NONCLUSTERED INDEX IX_FactSalesOrder_CustomerID
ON dbo.FactSalesOrder (CustomerID, OrderDate)
INCLUDE (TotalDue)
ON PS_SalesOrder_Year (OrderDate);   -- ← aligned
GO

CREATE NONCLUSTERED INDEX IX_FactSalesOrder_SalesPerson
ON dbo.FactSalesOrder (SalesPersonID, OrderDate)
INCLUDE (TotalDue, Status)
ON PS_SalesOrder_Year (OrderDate);   -- ← aligned
GO

-- ── 7.2  Non-aligned index (entire index on one filegroup) ────────────────────
-- Use when queries span many partitions and the index column ≠ partition key.
-- Downside: partition switching is blocked until this index is dropped/disabled.

CREATE NONCLUSTERED INDEX IX_FactSalesOrder_Status_NA
ON dbo.FactSalesOrder (Status, TotalDue)
ON [PRIMARY];    -- ← non-aligned (single filegroup)
GO

-- ── 7.3  Rebuild index for a SINGLE partition (online, minimal blocking) ──────
ALTER INDEX IX_FactSalesOrder_CustomerID
ON dbo.FactSalesOrder
REBUILD PARTITION = 3   -- only rebuild the 2021 partition
WITH (ONLINE = ON, DATA_COMPRESSION = ROW);
GO

-- ── 7.4  Rebuild ALL partitions with different compression per partition ───────
ALTER INDEX CIX_FactTransaction_TxnDate
ON dbo.FactTransaction
REBUILD PARTITION = ALL
WITH (
    DATA_COMPRESSION = PAGE ON PARTITIONS (1, 2, 3),  -- old data → PAGE compress
    DATA_COMPRESSION = ROW  ON PARTITIONS (4, 5, 6),  -- recent   → ROW compress
    DATA_COMPRESSION = NONE ON PARTITIONS (7, 8)      -- current  → no compress
);
GO

-- ── 7.5  Columnstore index on partitioned table ───────────────────────────────
-- Enables real-time analytics on partitioned fact tables (HTAP pattern)
CREATE NONCLUSTERED COLUMNSTORE INDEX NCSI_FactSalesOrder
ON dbo.FactSalesOrder (OrderDate, CustomerID, SalesPersonID, TotalDue, Status)
ON PS_SalesOrder_Year (OrderDate);
GO

-- ── 7.6  Verify index alignment ───────────────────────────────────────────────
SELECT
    i.name                      AS IndexName,
    i.type_desc                 AS IndexType,
    CASE
        WHEN i.data_space_id = t.data_space_id THEN 'ALIGNED'
        ELSE 'NON-ALIGNED'
    END                         AS Alignment,
    ds.name                     AS DataSpace
FROM sys.indexes          i
JOIN sys.tables           t  ON i.object_id = t.object_id
JOIN sys.data_spaces      ds ON i.data_space_id = ds.data_space_id
WHERE t.name = 'FactSalesOrder'
ORDER BY i.index_id;
GO


/* ============================================================================
   MODULE 08 — PARTITION SWITCHING
   ============================================================================
   Partition Switch = metadata-only operation (near-instant, fully logged).

   Three patterns:
   A. SWITCH IN  — load staging → production partition
   B. SWITCH OUT — archive partition → staging / archive table
   C. SLIDE      — switch out old, switch in new (rolling window)

   Rules for switching:
   1. Source and destination must have IDENTICAL structure (columns, types, nullability).
   2. All indexes must be ALIGNED (or non-aligned must be pre-dropped).
   3. Source and destination must be on the SAME filegroup as the target partition.
   4. Check constraints must guarantee data fits in the target partition.
   ============================================================================ */

USE PartitionLab;
GO

-- ── 8.1  SWITCH OUT: Archive 2019 partition to a staging table ────────────────

-- Step A: Create the archive table on the SAME filegroup as partition 1 (FG_2019)
CREATE TABLE dbo.FactSalesOrder_Archive_2019
(
    SalesOrderID    INT          NOT NULL,
    OrderDate       DATE         NOT NULL,
    CustomerID      INT          NOT NULL,
    SalesPersonID   INT          NULL,
    TotalDue        MONEY        NOT NULL DEFAULT 0,
    Status          TINYINT      NOT NULL DEFAULT 1,
    CreatedAt       DATETIME2(0) NOT NULL DEFAULT SYSUTCDATETIME(),
    CONSTRAINT PK_Archive_2019
        PRIMARY KEY CLUSTERED (SalesOrderID, OrderDate)
)
ON FG_2019;   -- ← must match the filegroup of partition 2 in PS_SalesOrder_Year
GO

-- Step B: Add matching non-clustered indexes
CREATE NONCLUSTERED INDEX IX_Archive_2019_Customer
ON dbo.FactSalesOrder_Archive_2019 (CustomerID, OrderDate)
INCLUDE (TotalDue)
ON FG_2019;
GO

-- Step C: Add a CHECK constraint to guarantee only 2019 data exists
ALTER TABLE dbo.FactSalesOrder_Archive_2019
