-- ── 18.2  Populate from normalized source tables ──────────────────────────────
INSERT INTO Sales.FactSalesAnalytics
SELECT
    soh.SalesOrderID,
    CAST(soh.OrderDate AS DATE),
    soh.CustomerID,
    soh.SalesPersonID,
    soh.TerritoryID,
    sod.ProductID,
    sod.OrderQty,
    sod.UnitPrice,
    sod.LineTotal,
    soh.SubTotal,
    soh.TotalDue,
    ISNULL(p.FirstName + ' ' + p.LastName, 'Online'),
    ISNULL(pp.FirstName + ' ' + pp.LastName, c.AccountNumber),
    pr.Name,
    pc.Name,
    st.Name
FROM Sales.SalesOrderHeader    soh
JOIN Sales.SalesOrderDetail    sod ON soh.SalesOrderID   = sod.SalesOrderID
JOIN Production.Product        pr  ON sod.ProductID       = pr.ProductID
