/* ============================================================================
   MODULE 19 — TROUBLESHOOTING & COMMON PITFALLS
   ============================================================================ */

USE PartitionLab;
GO

-- ── 19.1  Pitfall: Partition key not in clustered index ───────────────────────
-- ERROR: "The partition scheme 'PS_SalesOrder_Year' requires 1 partition column"
-- FIX: Include partition column in the clustered index / PK.
-- BAD:
--   CREATE TABLE T (ID INT PRIMARY KEY CLUSTERED, OrderDate DATE)
--   ON PS_SalesOrder_Year(OrderDate); -- ERROR!
-- GOOD:
--   CREATE TABLE T (ID INT, OrderDate DATE,
--     CONSTRAINT PK_T PRIMARY KEY CLUSTERED (ID, OrderDate)  -- include partition col
--   ) ON PS_SalesOrder_Year(OrderDate);

-- ── 19.2  Pitfall: SWITCH fails due to non-aligned index ──────────────────────
-- ERROR: "ALTER TABLE SWITCH statement failed."
-- FIX: Drop non-aligned indexes before switching, re-create after.

-- Check for non-aligned indexes:
SELECT
    i.name,
    CASE WHEN i.data_space_id = t.data_space_id THEN 'ALIGNED' ELSE 'NON-ALIGNED' END AS Alignment
FROM sys.indexes i
JOIN sys.tables  t ON i.object_id = t.object_id
WHERE t.name = 'FactSalesOrder';

-- ── 19.3  Pitfall: SPLIT causes data movement ─────────────────────────────────
-- A SPLIT where the boundary falls INSIDE a non-empty partition causes data
-- to be physically moved. This can be slow and generates heavy log.
-- FIX: Always split EMPTY partitions! Use SWITCH OUT first.

-- Check if partition is empty before splitting:
SELECT
    partition_number,
    rows
FROM sys.partitions
WHERE object_id = OBJECT_ID('dbo.FactSalesOrder')
  AND index_id <= 1
  AND rows > 0
ORDER BY partition_number;
GO

-- ── 19.4  Pitfall: Forgot NEXT USED before SPLIT ──────────────────────────────
-- ERROR: "There is no next used filegroup defined for partition scheme..."
-- FIX: Always run ALTER PARTITION SCHEME ... NEXT USED before SPLIT.

-- ── 19.5  Pitfall: CHECK constraint mismatch in SWITCH ────────────────────────
-- ERROR: "ALTER TABLE SWITCH statement failed because ... not all rows satisfy..."
-- FIX: Add CHECK constraint to destination table matching the partition range.

-- Diagnose: which rows would violate the constraint?
SELECT TOP 10 *
FROM dbo.FactSalesOrder
WHERE $PARTITION.PF_SalesOrder_Year(OrderDate) = 3
  AND (OrderDate < '2020-01-01' OR OrderDate >= '2021-01-01');
-- Should return 0 rows if data is clean

-- ── 19.6  Pitfall: NULL values in partition column ────────────────────────────
-- NULLs always go to partition 1 (the leftmost partition)
-- FIX: Add NOT NULL constraint to partition column
SELECT COUNT(*) AS NullPartitionKeyRows
FROM dbo.FactSalesOrder
WHERE OrderDate IS NULL;
GO

-- ── 19.7  Pitfall: Implicit conversion prevents partition elimination ──────────
-- If the partition column is DATE but you filter with VARCHAR, conversion happens.
-- BAD:
SELECT COUNT(*) FROM dbo.FactSalesOrder WHERE OrderDate = '20230101';  -- string
-- GOOD (explicit, same type):
SELECT COUNT(*) FROM dbo.FactSalesOrder WHERE OrderDate = CAST('2023-01-01' AS DATE);
GO

-- ── 19.8  Check for ghost records in columnstore partitions ───────────────────
SELECT
    p.partition_number,
    rg.state_desc,
    rg.deleted_rows,
    rg.total_rows,
    CAST(rg.deleted_rows * 100.0 / NULLIF(rg.total_rows,0) AS DECIMAL(5,1)) AS PctDeleted
FROM sys.column_store_row_groups rg
JOIN sys.partitions p
    ON rg.object_id = p.object_id AND rg.partition_id = p.partition_id
WHERE rg.object_id = OBJECT_ID('dbo.FactSalesColumnStore')
  AND rg.deleted_rows > 0
ORDER BY PctDeleted DESC;
GO

-- ── 19.9  Verify all partition functions and their table usage ─────────────────
SELECT
    pf.name                          AS PartitionFunction,
    ps.name                          AS PartitionScheme,
    OBJECT_NAME(i.object_id)         AS TableName,
    i.name                           AS IndexName,
    pf.fanout                        AS Partitions,
    SUM(p.rows)                      AS TotalRows
FROM sys.partition_functions   pf
JOIN sys.partition_schemes     ps ON pf.function_id   = ps.function_id
JOIN sys.indexes               i  ON ps.data_space_id = i.data_space_id
JOIN sys.partitions            p  ON i.object_id      = p.object_id
                                 AND i.index_id       = p.index_id
GROUP BY pf.name, ps.name, i.object_id, i.name, pf.fanout
ORDER BY pf.name, TableName;
GO

/* ============================================================================
   MODULE 20 — REAL-WORLD SCENARIO CHECKLISTS & QUICK REFERENCE
   ============================================================================ */
/*
──────────────────────────────────────────────────────────────────────────────
  DECISION GUIDE: Should I partition this table?
──────────────────────────────────────────────────────────────────────────────
  YES — Partition when:
      • Table > 10 GB and growing
      • Queries naturally filter on a date/range column
      • You need rolling archival (delete old data in bulk)
      • You need fast bulk load (SWITCH IN pattern)
      • Different compression levels needed per data age
      • Parallel index operations per partition required
      • Per-partition filegroup backup strategy needed

  NO — Don't partition when:
      • Table is < 1 GB
      • Queries don't filter on partition key
      • You need to partition by a non-deterministic column
      • Partition key has very low cardinality (< 10 distinct values)
      • Your partition count would exceed 1000 (use fewer, larger partitions)

──────────────────────────────────────────────────────────────────────────────
  PARTITION FUNCTION TYPE GUIDE
──────────────────────────────────────────────────────────────────────────────
  RANGE RIGHT (recommended for dates):
      Boundary '2023-01-01' → partition starts ON that date
      Use: yearly/monthly/daily date partitions

  RANGE LEFT:
      Boundary '2022-12-31' → partition ends ON that date (inclusive)
      Use: end-of-period boundary style

──────────────────────────────────────────────────────────────────────────────
  FILEGROUP STRATEGY
──────────────────────────────────────────────────────────────────────────────
  Dev/Test  : ALL TO [PRIMARY] — simplest, no setup needed
  Prod Small: 2-3 FGs (HOT / WARM / COLD)
  Prod Large: 1 FG per partition (separate drives, parallel I/O, FG backup)

──────────────────────────────────────────────────────────────────────────────
  COMPRESSION GUIDE PER PARTITION AGE
──────────────────────────────────────────────────────────────────────────────
  Current month (HOT) : NONE      — fastest writes/reads
  Last 6-12 months    : ROW       — 30-50% space saving, low overhead
  Older (WARM)        : PAGE      — 60-80% space saving
  Archive (COLD)      : COLUMNSTORE or PAGE — maximum compression

──────────────────────────────────────────────────────────────────────────────
  SLIDING WINDOW CHECKLIST (run monthly)
──────────────────────────────────────────────────────────────────────────────
  □ 1. Create staging table for new month
  □ 2. Set NEXT USED on partition scheme
  □ 3. SPLIT to create new empty partition
  □ 4. Load ETL data into staging table
  □ 5. Validate row counts and CHECK constraints in staging
  □ 6. SWITCH IN staging → production
  □ 7. Verify new partition has expected row count
  □ 8. SWITCH OUT oldest partition → archive table
  □ 9. Apply PAGE compression to archived partition
  □ 10. MERGE the now-empty old boundary
  □ 11. Update statistics (incremental)
  □ 12. Log completion and row counts

──────────────────────────────────────────────────────────────────────────────
  SWITCH REQUIREMENTS CHECKLIST
──────────────────────────────────────────────────────────────────────────────
  □ Source and destination same column structure & types
  □ All indexes aligned (same partition function) OR pre-dropped
  □ Source/destination on same filegroup as target partition
  □ CHECK constraint on source/destination matching partition range
  □ No non-aligned indexes (or disabled/dropped before switch)
  □ No foreign keys referencing source table (or disabled)
  □ Not a system-versioned temporal table (special handling needed)

──────────────────────────────────────────────────────────────────────────────
  SQL SERVER VERSION FEATURES (2019–2025)
──────────────────────────────────────────────────────────────────────────────
  2019: Accelerated Database Recovery (ADR) helps large partition ops
        Batch mode on rowstore (helps analytical queries on partitioned tables)
        Max partitions: 15,000

  2022: Ledger tables (append-only + partitioning compatible)
        Contained Availability Groups
        Query Store hints (force partition elimination plan)

  2025: Enhanced parallel partition operations
        Improved incremental statistics accuracy
        Better partition pruning for non-sargable predicates (improvements)

──────────────────────────────────────────────────────────────────────────────
  USEFUL SYSTEM OBJECTS FOR PARTITIONING
──────────────────────────────────────────────────────────────────────────────
  sys.partition_functions          — all partition functions
  sys.partition_range_values       — boundary values
  sys.partition_schemes            — partition schemes
  sys.destination_data_spaces      — scheme → filegroup mapping
  sys.partitions                   — partition metadata per object
  sys.allocation_units             — size info per partition
  sys.dm_db_index_physical_stats   — fragmentation per partition
  sys.column_store_row_groups      — columnstore delta store per partition
  sys.dm_db_stats_properties_internal — per-partition stats info
  $PARTITION.function_name(value)  — which partition does this value go to?
*/

-- ── 20.1  Golden diagnostic query: full partition inventory ──────────────────
SELECT
    SCHEMA_NAME(t.schema_id)          AS SchemaName,
    t.name                             AS TableName,
    pf.name                            AS PartitionFunction,
    ps.name                            AS PartitionScheme,
    p.partition_number                 AS PartNum,
    CAST(prv.value AS NVARCHAR(50))    AS BoundaryValue,
    p.rows                             AS RowCount,
    CAST(au.total_pages * 8.0 / 1024  AS DECIMAL(10,2)) AS TotalMB,
    CAST(au.used_pages  * 8.0 / 1024  AS DECIMAL(10,2)) AS UsedMB,
    fg.name                            AS FileGroup,
    p.data_compression_desc            AS Compression
FROM sys.tables                  t
JOIN sys.indexes                 i   ON t.object_id     = i.object_id AND i.index_id <= 1
JOIN sys.partition_schemes       ps  ON i.data_space_id = ps.data_space_id
JOIN sys.partition_functions     pf  ON ps.function_id  = pf.function_id
JOIN sys.partitions              p   ON i.object_id     = p.object_id AND i.index_id = p.index_id
JOIN sys.allocation_units        au  ON p.partition_id  = au.container_id
LEFT JOIN sys.partition_range_values prv
    ON pf.function_id = prv.function_id
    AND p.partition_number = CASE pf.boundary_value_on_right WHEN 1 THEN prv.boundary_id + 1
                                                              ELSE prv.boundary_id END
JOIN sys.destination_data_spaces dds ON ps.data_space_id = dds.partition_scheme_id
    AND dds.destination_id = p.partition_number
JOIN sys.filegroups              fg  ON dds.data_space_id = fg.data_space_id
ORDER BY t.name, p.partition_number;
GO

