/* ============================================================================
   MODULE 14 — PARTITIONED VIEWS vs TABLE PARTITIONING
   ============================================================================
   Partitioned Views: UNION ALL of multiple physical tables with CHECK constraints.
   Older pattern (pre-SQL Server 2005). Still useful for cross-database scenarios.
   ============================================================================ */

USE PartitionLab;
GO

-- ── 14.1  Create member tables ────────────────────────────────────────────────
CREATE TABLE dbo.Orders_2022
(
    OrderID   INT  NOT NULL,
    OrderYear INT  NOT NULL CHECK (OrderYear = 2022),
    Amount    MONEY NOT NULL,
    CONSTRAINT PK_Orders_2022 PRIMARY KEY (OrderID, OrderYear)
);

CREATE TABLE dbo.Orders_2023
(
    OrderID   INT  NOT NULL,
    OrderYear INT  NOT NULL CHECK (OrderYear = 2023),
    Amount    MONEY NOT NULL,
    CONSTRAINT PK_Orders_2023 PRIMARY KEY (OrderID, OrderYear)
);

CREATE TABLE dbo.Orders_2024
(
    OrderID   INT  NOT NULL,
    OrderYear INT  NOT NULL CHECK (OrderYear = 2024),
    Amount    MONEY NOT NULL,
    CONSTRAINT PK_Orders_2024 PRIMARY KEY (OrderID, OrderYear)
);
GO

-- ── 14.2  Create the partitioned view ─────────────────────────────────────────
CREATE VIEW dbo.vw_Orders_Partitioned
AS
    SELECT * FROM dbo.Orders_2022
    UNION ALL
    SELECT * FROM dbo.Orders_2023
    UNION ALL
    SELECT * FROM dbo.Orders_2024;
GO

-- ── 14.3  INSERT into the view (SQL Server routes to correct table) ────────────
INSERT INTO dbo.vw_Orders_Partitioned VALUES (1001, 2023, 500.00);
INSERT INTO dbo.vw_Orders_Partitioned VALUES (1002, 2024, 750.00);
GO

-- ── 14.4  Query with partition elimination ────────────────────────────────────
SELECT * FROM dbo.vw_Orders_Partitioned WHERE OrderYear = 2023;
-- Only Orders_2023 is accessed
GO

-- When to choose Partitioned View vs Table Partitioning:
--   Use TABLE PARTITIONING for: same server, large tables, switching, simplicity
--   Use PARTITIONED VIEW for  : cross-database, cross-server, legacy compat


