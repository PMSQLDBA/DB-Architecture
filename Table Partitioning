/* ============================================================================
   MODULE 11 — MONITORING & DIAGNOSTICS
   ============================================================================ */
USE PartitionLab;
GO
-- ── 11.1  Row count per partition (all partitioned tables) ────────────────────
SELECT
    OBJECT_NAME(p.object_id)        AS TableName,
    i.name                          AS IndexName,
    i.type_desc                     AS IndexType,
    p.partition_number              AS PartitionNum,
    p.rows                          AS RowCount,
    CAST(prv.value AS VARCHAR(30))  AS BoundaryValue,
    fg.name                         AS Filegroup,
    au.total_pages * 8 / 1024.0    AS TotalMB,
    au.used_pages  * 8 / 1024.0    AS UsedMB
FROM sys.partitions              p
JOIN sys.indexes                 i   ON p.object_id   = i.object_id
                                    AND p.index_id    = i.index_id
JOIN sys.partition_schemes       ps  ON i.data_space_id = ps.data_space_id
JOIN sys.partition_functions     pf  ON ps.function_id  = pf.function_id
LEFT JOIN sys.partition_range_values prv
    ON pf.function_id = prv.function_id
    AND p.partition_number = prv.boundary_id + 1
JOIN sys.destination_data_spaces dds ON ps.data_space_id = dds.partition_scheme_id
    AND dds.destination_id = p.partition_number
JOIN sys.filegroups              fg  ON dds.data_space_id = fg.data_space_id
JOIN sys.allocation_units        au  ON p.partition_id   = au.container_id
WHERE i.index_id <= 1
  AND p.object_id = OBJECT_ID('dbo.FactSalesOrder')
ORDER BY p.partition_number;
GO

-- ── 11.2  Partition fragmentation ─────────────────────────────────────────────
SELECT
    OBJECT_NAME(ips.object_id)    AS TableName,
    i.name                         AS IndexName,
    ips.partition_number,
    ips.avg_fragmentation_in_percent,
    ips.page_count,
    ips.record_count,
    ips.index_type_desc
FROM sys.dm_db_index_physical_stats(
        DB_ID(), OBJECT_ID('dbo.FactSalesOrder'), NULL, NULL, 'LIMITED') ips
JOIN sys.indexes i ON ips.object_id = i.object_id AND ips.index_id = i.index_id
ORDER BY ips.partition_number;
GO

-- ── 11.3  Statistics per partition ────────────────────────────────────────────
SELECT
    OBJECT_NAME(s.object_id)       AS TableName,
    s.name                          AS StatName,
    sp.partition_number,
    sp.rows,
    sp.rows_sampled,
    sp.last_updated,
    sp.modification_counter
FROM sys.stats                      s
CROSS APPLY sys.dm_db_stats_properties_internal(s.object_id, s.stats_id) sp
WHERE s.object_id = OBJECT_ID('dbo.FactSalesOrder')
ORDER BY s.name, sp.partition_number;
GO

-- ── 11.4  Active partition operations in progress ─────────────────────────────
SELECT
    r.session_id,
    r.command,
    r.status,
    r.percent_complete,
    SUBSTRING(st.text, (r.statement_start_offset/2)+1,
              ((CASE r.statement_end_offset WHEN -1 THEN DATALENGTH(st.text)
                ELSE r.statement_end_offset END - r.statement_start_offset)/2)+1) AS StatementText,
    r.wait_type,
    r.wait_time / 1000.0 AS WaitSec
FROM sys.dm_exec_requests r
CROSS APPLY sys.dm_exec_sql_text(r.sql_handle) st
WHERE r.command LIKE '%PARTITION%' OR st.text LIKE '%SWITCH%'
   OR st.text LIKE '%SPLIT%'       OR st.text LIKE '%MERGE%';
GO

-- ── 11.5  Comprehensive partition health dashboard ────────────────────────────
SELECT
    t.name                               AS TableName,
    pf.name                              AS PartitionFunction,
    pf.fanout                            AS TotalPartitions,
    SUM(p.rows)                          AS TotalRows,
    SUM(au.total_pages) * 8 / 1024.0    AS TotalTableMB,
    MIN(CAST(prv.value AS VARCHAR(30)))  AS OldestBoundary,
    MAX(CAST(prv.value AS VARCHAR(30)))  AS NewestBoundary
FROM sys.tables t
JOIN sys.indexes             i   ON t.object_id     = i.object_id AND i.index_id <= 1
JOIN sys.partition_schemes   ps  ON i.data_space_id = ps.data_space_id
JOIN sys.partition_functions pf  ON ps.function_id  = pf.function_id
JOIN sys.partitions          p   ON i.object_id     = p.object_id AND i.index_id = p.index_id
JOIN sys.allocation_units    au  ON p.partition_id  = au.container_id
LEFT JOIN sys.partition_range_values prv ON pf.function_id = prv.function_id
GROUP BY t.name, pf.name, pf.fanout
ORDER BY TotalTableMB DESC;
GO


