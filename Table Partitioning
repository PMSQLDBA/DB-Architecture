/* ============================================================================
   MODULE 13 — ADVANCED: FULL SLIDING WINDOW AUTOMATION
   ============================================================================
   Real-World Scenario:
   A data warehouse loads monthly sales data. Each month:
     1. Add a new future partition (SPLIT)
     2. Load new data into staging
     3. SWITCH IN staging → production
     4. SWITCH OUT oldest partition → archive
     5. MERGE the old empty partition
   ============================================================================ */

USE PartitionLab;
GO

-- ── 13.1  Setup: 12-month rolling partition table ────────────────────────────
-- We use a monthly partition function
CREATE PARTITION FUNCTION PF_SlidingWindow (DATE)
AS RANGE RIGHT
FOR VALUES (
    '2024-01-01','2024-02-01','2024-03-01','2024-04-01',
    '2024-05-01','2024-06-01','2024-07-01','2024-08-01',
    '2024-09-01','2024-10-01','2024-11-01','2024-12-01',
    '2025-01-01'
);
GO

CREATE PARTITION SCHEME PS_SlidingWindow
AS PARTITION PF_SlidingWindow
ALL TO ([PRIMARY]);
GO

CREATE TABLE dbo.FactDailySales
(
    SaleID        BIGINT  IDENTITY(1,1) NOT NULL,
    SaleDate      DATE    NOT NULL,
    StoreID       INT     NOT NULL,
    ProductID     INT     NOT NULL,
    Qty           INT     NOT NULL,
    Revenue       MONEY   NOT NULL,
    CONSTRAINT PK_FactDailySales PRIMARY KEY CLUSTERED (SaleID, SaleDate)
    ON PS_SlidingWindow (SaleDate)
)
ON PS_SlidingWindow (SaleDate);
GO

-- Archive table (same structure, [PRIMARY] filegroup)
CREATE TABLE dbo.FactDailySales_Archive
(
    SaleID        BIGINT  NOT NULL,
    SaleDate      DATE    NOT NULL,
    StoreID       INT     NOT NULL,
    ProductID     INT     NOT NULL,
    Qty           INT     NOT NULL,
    Revenue       MONEY   NOT NULL,
    CONSTRAINT PK_FactDailySales_Archive PRIMARY KEY CLUSTERED (SaleID, SaleDate)
)
ON [PRIMARY];
GO

-- ── 13.2  The Sliding Window Stored Procedure ─────────────────────────────────
CREATE OR ALTER PROCEDURE dbo.usp_SlidingWindowAdvance
    @NewMonth DATE  -- e.g. '2025-02-01'
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    DECLARE @OldMonth   DATE = DATEADD(MONTH, -13, @NewMonth); -- oldest boundary
    DECLARE @NextMonth  DATE = DATEADD(MONTH,   1, @NewMonth); -- boundary after new
    DECLARE @StagingTable   SYSNAME;
    DECLARE @CheckSql       NVARCHAR(MAX);
    DECLARE @SwitchSql      NVARCHAR(MAX);
    DECLARE @PartNew        INT;
    DECLARE @PartOld        INT;

    PRINT '====== Sliding Window Advance ======';
    PRINT 'New Month  : ' + CONVERT(VARCHAR, @NewMonth, 23);
    PRINT 'Old Boundary to remove: ' + CONVERT(VARCHAR, @OldMonth, 23);

    -- ── Step 1: Create staging table for new month ────────────────────────────
    SET @StagingTable = 'dbo.FactDailySales_Stage_' + FORMAT(@NewMonth, 'yyyyMM');

    SET @CheckSql = N'
    IF OBJECT_ID(''' + @StagingTable + ''') IS NULL
    BEGIN
        CREATE TABLE ' + @StagingTable + '
        (
            SaleID    BIGINT NOT NULL,
            SaleDate  DATE   NOT NULL,
            StoreID   INT    NOT NULL,
            ProductID INT    NOT NULL,
            Qty       INT    NOT NULL,
            Revenue   MONEY  NOT NULL,
            CONSTRAINT PK_Stage_' + FORMAT(@NewMonth,'yyyyMM') + '
                PRIMARY KEY CLUSTERED (SaleID, SaleDate)
        ) ON [PRIMARY];

        ALTER TABLE ' + @StagingTable + '
        ADD CONSTRAINT CHK_Stage_' + FORMAT(@NewMonth,'yyyyMM') + '
        CHECK (SaleDate >= ''' + CONVERT(VARCHAR,@NewMonth,23) + ''' AND SaleDate < ''' + CONVERT(VARCHAR,@NextMonth,23) + ''');

        PRINT ''Staging table created: ' + @StagingTable + ''';
    END';
    EXEC sp_executesql @CheckSql;

    PRINT 'Step 1 complete: Staging table ready';

    -- ── Step 2: SPLIT to create new future partition ─────────────────────────
    -- (Skip if boundary already exists)
    IF NOT EXISTS (
        SELECT 1 FROM sys.partition_range_values prv
        JOIN sys.partition_functions pf ON prv.function_id = pf.function_id
        WHERE pf.name = 'PF_SlidingWindow'
          AND CAST(prv.value AS DATE) = @NextMonth
    )
    BEGIN
        ALTER PARTITION SCHEME PS_SlidingWindow NEXT USED [PRIMARY];
        ALTER PARTITION FUNCTION PF_SlidingWindow() SPLIT RANGE (@NextMonth);
        PRINT 'Step 2 complete: Split partition for ' + CONVERT(VARCHAR,@NextMonth,23);
    END
    ELSE
        PRINT 'Step 2 skipped: Boundary ' + CONVERT(VARCHAR,@NextMonth,23) + ' already exists';

    -- ── Step 3: Load data into staging (caller populates before switching) ────
    PRINT 'Step 3: Populate ' + @StagingTable + ' with new month data before Step 4.';
    -- In real scenario, ETL process fills staging here.
    -- For lab: insert sample data:
    SET @CheckSql = N'
    IF NOT EXISTS (SELECT 1 FROM ' + @StagingTable + ')
    BEGIN
        INSERT INTO ' + @StagingTable + ' (SaleID, SaleDate, StoreID, ProductID, Qty, Revenue)
        SELECT TOP 1000
            ABS(CHECKSUM(NEWID())) % 9000000 + 1000000,
            DATEADD(DAY, ABS(CHECKSUM(NEWID())) % 28, ''' + CONVERT(VARCHAR,@NewMonth,23) + '''),
            ABS(CHECKSUM(NEWID())) % 100 + 1,
            ABS(CHECKSUM(NEWID())) % 500 + 1,
            ABS(CHECKSUM(NEWID())) % 50  + 1,
            ABS(CHECKSUM(NEWID())) % 5000 / 100.0
        FROM sys.all_columns;
        PRINT ''Sample data loaded into staging'';
    END';
    EXEC sp_executesql @CheckSql;

    -- ── Step 4: SWITCH IN staging → production ───────────────────────────────
    SET @PartNew = $PARTITION.PF_SlidingWindow(@NewMonth);

    SET @SwitchSql = N'ALTER TABLE ' + @StagingTable
                   + N' SWITCH TO dbo.FactDailySales PARTITION '
                   + CAST(@PartNew AS NVARCHAR(5)) + N';';
    EXEC sp_executesql @SwitchSql;
    PRINT 'Step 4 complete: Switched IN partition ' + CAST(@PartNew AS VARCHAR) + ' (' + CONVERT(VARCHAR,@NewMonth,23) + ')';

    -- ── Step 5: SWITCH OUT oldest partition → archive ────────────────────────
    SET @PartOld = $PARTITION.PF_SlidingWindow(@OldMonth);

    -- Ensure archive has matching CHECK constraint
    IF NOT EXISTS (
        SELECT 1 FROM sys.check_constraints
        WHERE parent_object_id = OBJECT_ID('dbo.FactDailySales_Archive')
          AND definition LIKE '%' + CONVERT(VARCHAR,@OldMonth,23) + '%'
    )
    BEGIN
        SET @CheckSql = N'
        ALTER TABLE dbo.FactDailySales_Archive
        ADD CONSTRAINT CHK_Archive_' + FORMAT(@OldMonth,'yyyyMM') + '
        CHECK (1=1);';  -- broad constraint; archive accepts any data
        -- In practice, use separate archive tables per period
    END;

    SET @SwitchSql = N'ALTER TABLE dbo.FactDailySales SWITCH PARTITION '
                   + CAST(@PartOld AS NVARCHAR(5))
                   + N' TO dbo.FactDailySales_Archive;';
    EXEC sp_executesql @SwitchSql;
    PRINT 'Step 5 complete: Switched OUT partition ' + CAST(@PartOld AS VARCHAR) + ' (' + CONVERT(VARCHAR,@OldMonth,23) + ')';

    -- ── Step 6: MERGE oldest empty boundary ──────────────────────────────────
    ALTER PARTITION FUNCTION PF_SlidingWindow() MERGE RANGE (@OldMonth);
    PRINT 'Step 6 complete: Merged boundary ' + CONVERT(VARCHAR,@OldMonth,23);

    -- ── Step 7: Drop staging table (optional, or keep for audit) ─────────────
    SET @CheckSql = N'DROP TABLE IF EXISTS ' + @StagingTable + ';';
    EXEC sp_executesql @CheckSql;
    PRINT 'Step 7 complete: Staging table cleaned up';

    PRINT '====== Sliding Window Complete ======';
END;
GO

