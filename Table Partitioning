-- ── 12.6  Automated maintenance stored procedure ──────────────────────────────
CREATE OR ALTER PROCEDURE dbo.usp_MaintainPartitions
    @TableName      SYSNAME,
    @SchemaName     SYSNAME = 'dbo',
    @FragThreshold  FLOAT   = 30.0,   -- % fragmentation threshold
    @MaxDOP         INT     = 4
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @SQL        NVARCHAR(MAX);
    DECLARE @ObjId      INT = OBJECT_ID(QUOTENAME(@SchemaName) + '.' + QUOTENAME(@TableName));
    DECLARE @PartNum    INT;
    DECLARE @AvgFrag    FLOAT;
    DECLARE @Pages      BIGINT;
    DECLARE @IndexId    INT;
    DECLARE @IndexName  SYSNAME;

    IF @ObjId IS NULL
    BEGIN
        RAISERROR('Table %s.%s not found.', 16, 1, @SchemaName, @TableName);
        RETURN;
    END;

    DECLARE cPartitions CURSOR LOCAL FAST_FORWARD FOR
    SELECT
        ips.partition_number,
        ips.avg_fragmentation_in_percent,
        ips.page_count,
        ips.index_id,
        i.name
    FROM sys.dm_db_index_physical_stats(DB_ID(), @ObjId, NULL, NULL, 'LIMITED') ips
    JOIN sys.indexes i ON ips.object_id = i.object_id AND ips.index_id = i.index_id
    WHERE ips.avg_fragmentation_in_percent > 10
      AND ips.page_count > 1000
    ORDER BY ips.avg_fragmentation_in_percent DESC;

    OPEN cPartitions;
    FETCH NEXT FROM cPartitions INTO @PartNum, @AvgFrag, @Pages, @IndexId, @IndexName;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        IF @AvgFrag >= @FragThreshold
        BEGIN
            -- High fragmentation → REBUILD
            SET @SQL = N'ALTER INDEX ' + QUOTENAME(@IndexName) + N' ON '
                     + QUOTENAME(@SchemaName) + N'.' + QUOTENAME(@TableName)
                     + N' REBUILD PARTITION = ' + CAST(@PartNum AS NVARCHAR(10))
                     + N' WITH (ONLINE = ON, MAXDOP = ' + CAST(@MaxDOP AS NVARCHAR(5))
                     + N', DATA_COMPRESSION = ROW);';
        END
        ELSE
        BEGIN
            -- Low-medium fragmentation → REORGANIZE (online, always)
            SET @SQL = N'ALTER INDEX ' + QUOTENAME(@IndexName) + N' ON '
                     + QUOTENAME(@SchemaName) + N'.' + QUOTENAME(@TableName)
                     + N' REORGANIZE PARTITION = ' + CAST(@PartNum AS NVARCHAR(10)) + N';';
        END;

        PRINT 'Executing: ' + @SQL;
        EXEC sp_executesql @SQL;

        FETCH NEXT FROM cPartitions INTO @PartNum, @AvgFrag, @Pages, @IndexId, @IndexName;
    END;

    CLOSE cPartitions;
    DEALLOCATE cPartitions;

    -- Update incremental stats for all partitions that were maintained
    SET @SQL = N'UPDATE STATISTICS ' + QUOTENAME(@SchemaName) + N'.' + QUOTENAME(@TableName)
             + N' WITH INCREMENTAL = ON, FULLSCAN;';
    EXEC sp_executesql @SQL;

    PRINT 'Partition maintenance complete for ' + @SchemaName + '.' + @TableName;
END;
GO

